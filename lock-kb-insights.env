# LOCK KB insight extractor LLM settings.
#
# This file is auto-loaded by lock_kb_insights.py when it sits next to the
# script. For auto-load, existing shell environment variables win. If you pass
# this file with --env-file, this file wins over shell env. CLI flags always win.
#
# Local APIM mimic settings. The mimic forwards bearer auth to Foundry and
# exposes POST {base_url}/chat/completions.
LOCK_KB_LLM_MODE=azure-apim
LOCK_KB_LLM_BASE_URL=http://127.0.0.1:53144
LOCK_KB_LLM_MODEL=gpt-5-4
LOCK_KB_AZURE_SCOPE=https://ai.azure.com/.default
LOCK_KB_LLM_TIMEOUT=220
LOCK_KB_MAX_EXCERPT_CHARS=18000
LOCK_KB_HEARTBEAT_SECONDS=30
LOCK_KB_LLM_MAX_ATTEMPTS=2
LOCK_KB_LLM_RETRY_SLEEP_SECONDS=5

# Optional. Leave blank to write lock_kb_insights.log inside each output dir.
# LOCK_KB_LOG_FILE=/path/to/lock-kb-insights.log
# Optional retry source. Usually pass this on CLI instead.
# LOCK_KB_RETRY_FAILED_FROM=/path/to/prior/output-dir

# CORP swap example:
# LOCK_KB_LLM_BASE_URL=https://apim.corp.com/ai-models/ai-realtime-inference-t101/v1
# LOCK_KB_LLM_MODEL=<resolved-corp-deployment-name>
